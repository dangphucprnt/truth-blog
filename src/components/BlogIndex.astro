---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { postPath, postTopic, TOPICS } from '../utils/blog.mjs';

const allPosts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const {topic = null, label = 'Truth Blog'} = Astro.props;
const posts = topic ? allPosts.filter(post=>postTopic(post)===topic) : allPosts;
const topicLabel = post => TOPICS.find(item=>item.id===postTopic(post))?.label || 'Truth Blog';
const formatDate = date => date.toLocaleDateString('vi-VN',{day:'numeric',month:'long',year:'numeric'});
---
<!doctype html>
<html lang="vi">
  <head>
    <BaseHead title={topic ? label+' | '+SITE_TITLE : SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      :global(body) { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans", Arial, sans-serif; font-size: 16px; line-height: 1.5; background: #f5f5f7; -webkit-font-smoothing: antialiased; }
      main { width: min(980px, calc(100% - 48px)); max-width: none; margin: 0 auto; padding: 40px 0 52px; }
      h1 { margin: 0; font-size: 28px; line-height: 1.2; letter-spacing: -.02em; }
      .intro { margin: 10px 0 28px; font-size: 15px; color: #6e6e73; }
      .posts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; list-style:none; padding:0; margin:0; }
      .posts li { min-width:0; }
      .card { display:flex;flex-direction:column;height:100%;overflow:hidden;border-radius:16px;background:#fff;text-decoration:none;color:#1d1d1f;transition:box-shadow .2s; }
      .card:hover { box-shadow:0 8px 24px #0000000b; }
      .card:focus-visible { outline:2px solid #0071e3;outline-offset:4px; }
      .cover { width:100%;aspect-ratio:16/9;overflow:hidden;flex-shrink:0; }
      .cover img { display:block;width:100%;height:100%;object-fit:cover;border-radius:0; }
      .details { padding:22px 24px;min-width:0; }
      .category { display:block;margin:0 0 9px;font-size:11px;font-weight:600;letter-spacing:.05em;color:#6e6e73; }
      h2 { font-size:22px;line-height:1.3;letter-spacing:-.015em;margin:0 0 14px;color:inherit;overflow-wrap:break-word; }
      time { display:block;font-size:12px;color:#6e6e73;line-height:1.5; }
      .posts li:first-child { grid-column:1/-1; }
      .posts li:first-child .card { flex-direction:row;align-items:stretch; }
      .posts li:first-child .cover { width:55%;aspect-ratio:auto;min-height:240px;max-height:320px; }
      .posts li:first-child .details { flex:1;align-self:center;padding:28px; }
      .posts li:first-child h2 { font-size:26px; }
      .empty { font-size:14px;color:#6e6e73;margin:0; }
      @media(max-width:734px) {
        main { width:calc(100% - 36px);padding:28px 0 36px; }
        h1 { font-size:24px; }
        .intro { font-size:14px;margin-bottom:22px; }
        .posts { grid-template-columns:1fr;gap:18px; }
        .posts li:first-child .card { flex-direction:column; }
        .cover,.posts li:first-child .cover { width:100%;aspect-ratio:16/9;min-height:0;max-height:230px; }
        .details,.posts li:first-child .details { padding:18px 20px;align-self:stretch; }
        h2,.posts li:first-child h2 { font-size:20px;line-height:1.3;margin-bottom:12px; }
        .card { border-radius:12px; }
      }
      @media(prefers-reduced-motion:reduce) { .card { transition:none; } }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section aria-labelledby="blog-index-title">
        <h1 id="blog-index-title">{topic ? label : 'Truth Blog'}</h1>
        <p class="intro">{topic ? 'Các bài viết trong chuyên mục '+label+'.' : SITE_DESCRIPTION}</p>
        {!posts.length && <p class="empty">Chưa có bài viết.</p>}
        <ul class="posts">
          {posts.map((post,index)=>(
            <li><a class="card" href={postPath(post,allPosts)}>
              {post.data.heroImage && <div class="cover"><Image width={720} height={405} src={post.data.heroImage} alt={post.data.heroAlt || ''} loading={index===0 ? 'eager' : 'lazy'} /></div>}
              <div class="details">
                <span class="category">{topicLabel(post)}</span>
                <h2>{post.data.title}</h2>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </div>
            </a></li>
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
