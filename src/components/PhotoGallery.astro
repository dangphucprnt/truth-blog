---
type Photo = { src: string; alt?: string; caption?: string };
const { photos = [] } = Astro.props as { photos?: Photo[] };
const items = photos.slice(0, 6);
---
{items.length > 0 && <div class="photo-gallery" data-photo-gallery data-count={items.length}>
    <div class="gallery-grid" aria-label="Bộ sưu tập ảnh">
        {items.map((photo, index) => <figure>
            <a href={photo.src} data-gallery-photo aria-label={`Xem ảnh ${index + 1}: ${photo.alt || photo.caption || 'Bộ sưu tập'}`}>
                <img src={photo.src} alt={photo.alt || photo.caption || `Ảnh ${index + 1} trong bộ sưu tập`} loading="lazy" decoding="async" />
            </a>
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>)}
    </div>
    <template><dialog class="gallery-viewer" aria-label="Xem ảnh lớn">
        <div class="viewer-content">
            <button type="button" class="viewer-close" aria-label="Đóng ảnh">×</button>
            <img class="viewer-image" alt="" />
            <p class="viewer-caption"></p>
            <p class="viewer-error" role="status" hidden>Không tải được ảnh, vui lòng thử ảnh khác hoặc mở đường dẫn gốc.</p>
            <div class="viewer-controls">
                <button type="button" class="viewer-prev" aria-label="Ảnh trước">‹</button>
                <span class="viewer-counter" aria-live="polite"></span>
                <button type="button" class="viewer-next" aria-label="Ảnh tiếp theo">›</button>
            </div>
        </div>
    </dialog></template>
</div>}
