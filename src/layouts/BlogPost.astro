---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroAlt, heroCaption, gallery } = Astro.props;
const pageURL = new URL(Astro.url.pathname, Astro.site).href;
const articleSchema = {
    '@context': 'https://schema.org', '@type': 'BlogPosting',
    headline: title, description, url: pageURL,
    mainEntityOfPage: pageURL, inLanguage: 'vi-VN',
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate || pubDate).toISOString(),
    ...(heroImage ? {image: new URL(heroImage.src, Astro.site).href} : {}),
    publisher: {'@type': 'Organization', name: 'Truth News', url: 'https://truth.com.vn/'},
};
---

<html lang="vi">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" ads={true} />
        <meta property="article:published_time" content={pubDate.toISOString()} />
        {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
        <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')} />
		<style>
            :global(body) { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
            main { width: 100%; max-width: none; margin: 0 auto; padding: 48px 0 56px; }
            #truth-blog-article { width: 100%; font-size: 17px; line-height: 1.65; }
            .prose, .title { width: min(680px, calc(100% - 48px)); max-width: none; margin-inline: auto; padding: 0; box-sizing: border-box; color: rgb(var(--gray-dark)); }
            .title { margin-bottom: 28px; text-align: left; }
            .title h1 { font-size: 36px; line-height: 1.18; letter-spacing: -0.015em; font-weight: 700; margin: 12px 0 0; overflow-wrap: break-word; }
            .date { font-size: 13px; line-height: 1.5; color: rgb(var(--gray)); }
            .last-updated-on { margin-top: 4px; font-style: italic; }
            .hero-image { width: min(980px, calc(100% - 48px)); margin: 0 auto 36px; }
            .hero-image img { display: block; width: 100%; height: auto; margin: 0 auto; border-radius: 12px; box-shadow: none; }
            .hero-image figcaption { margin: 12px auto 0; max-width: 680px; text-align: center; font-size: 13px; line-height: 1.5; font-style: italic; color: rgb(var(--gray)); }
            #truth-blog-body { text-align: left; }
            #truth-blog-body :global(p) { font-size: inherit; line-height: inherit; margin: 0 0 22px; text-align: left; }
            #truth-blog-body :global(h1), #truth-blog-body :global(h2), #truth-blog-body :global(h3), #truth-blog-body :global(h4), #truth-blog-body :global(h5), #truth-blog-body :global(h6) { text-align: left; line-height: 1.3; letter-spacing: -0.015em; margin: 32px 0 14px; }
            #truth-blog-body :global(h1), #truth-blog-body :global(h2) { font-size: 26px; }
            #truth-blog-body :global(h3) { font-size: 23px; }
            #truth-blog-body :global(h4) { font-size: 20px; }
            #truth-blog-body :global(h5), #truth-blog-body :global(h6) { font-size: 18px; }
            #truth-blog-body :global(ul), #truth-blog-body :global(ol) { margin: 0 0 24px; padding-left: 1.5em; text-align: left; }
            #truth-blog-body :global(li) { margin: 0 0 10px; }
            #truth-blog-body :global(li > p) { margin-bottom: 14px; }
            #truth-blog-body :global(blockquote) { margin: 24px 0; padding: 0 0 0 18px; font-size: inherit; line-height: inherit; text-align: left; }
            #truth-blog-body :global(img), #truth-blog-body :global(video) { display: block; max-width: 100%; height: auto; margin-inline: auto; border-radius: 10px; }
            #truth-blog-body :global(figure) { max-width: 100%; margin: 28px 0; text-align: center; }
            #truth-blog-body :global(figcaption), #truth-blog-body :global(figcaption p), #truth-blog-body :global(.caption), #truth-blog-body :global(.image-caption) { margin: 10px 0 0; font-size: 13px; line-height: 1.5; font-style: italic; text-align: center; color: rgb(var(--gray)); }
            #truth-blog-body :global(pre) { max-width: 100%; overflow-x: auto; box-sizing: border-box; padding: 16px; font-size: 14px; line-height: 1.6; }
            #truth-blog-body :global(table) { display: block; max-width: 100%; width: 100%; overflow-x: auto; font-size: 15px; }
            #truth-blog-body :global(th), #truth-blog-body :global(td) { padding: 8px 10px; }
            #truth-blog-body :global(iframe) { max-width: 100%; }
            #truth-blog-body :global(a) { overflow-wrap: anywhere; }
            @media (max-width: 734px) {
                main { padding: 28px 0 40px; }
                #truth-blog-article { font-size: 16px; line-height: 1.65; }
                .prose, .title { width: calc(100% - 36px); }
                .title { margin-bottom: 22px; }
                .title h1 { font-size: 28px; line-height: 1.2; }
                .hero-image { width: calc(100% - 36px); margin-bottom: 26px; }
                .hero-image img { border-radius: 8px; }
                .hero-image figcaption { font-size: 12px; }
                #truth-blog-body :global(p) { margin-bottom: 18px; }
                #truth-blog-body :global(h1), #truth-blog-body :global(h2) { font-size: 22px; }
                #truth-blog-body :global(h3) { font-size: 20px; }
                #truth-blog-body :global(h4), #truth-blog-body :global(h5), #truth-blog-body :global(h6) { font-size: 18px; }
                #truth-blog-body :global(figcaption), #truth-blog-body :global(figcaption p), #truth-blog-body :global(.caption), #truth-blog-body :global(.image-caption) { font-size: 12px; }
            }

            #truth-blog-body :global(.truth-sources-heading) { font-size: 16px !important; line-height: 1.5; margin: 28px 0 10px; color: #1d1d1f; }
            #truth-blog-body :global(.truth-source-entry), #truth-blog-body :global(.truth-source-entry *) { font-size: 13px !important; line-height: 1.65 !important; color: #1d1d1f !important; }
            #truth-blog-body :global(.truth-source-entry) { margin-bottom: 12px; }
            #truth-blog-body :global(.truth-source-entry li) { margin-bottom: 6px; }
            #truth-blog-body :global(.truth-source-entry a) { text-decoration: none; }
            #truth-blog-body :global(.truth-source-entry a:hover), #truth-blog-body :global(.truth-source-entry a:focus-visible) { text-decoration: underline; }
</style>
	</head>

	<body>
		<Header />
		<main>
			<article id="truth-blog-article">
                <div class="title">
                    <div class="date">
                        <FormattedDate date={pubDate} />
                        {updatedDate && <div class="last-updated-on">Cập nhật: <FormattedDate date={updatedDate} /></div>}
                    </div>
                    <h1>{title}</h1>
                </div>
                {heroImage && <figure class="hero-image">
                    <Image width={1020} height={510} src={heroImage} alt={heroAlt || ''} />
                    {heroCaption && <figcaption>{heroCaption}</figcaption>}
                </figure>}
                <div class="prose">
                    <div id="truth-blog-body"><PhotoGallery photos={gallery} /><slot /></div>
                </div>
			</article>
		</main>
		<Footer />
	<script is:inline src="/blog-share-footer.js?v=20261004-responsive" defer></script>
	<script is:inline src="/blog-sources.js?v=20261004-sources" defer></script>
	</body>
</html>
