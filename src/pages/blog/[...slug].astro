import {getCollection} from 'astro:content';
import {postPath} from '../../utils/blog.mjs';
export async function getStaticPaths(){const posts=await getCollection('blog');return posts.map(post=>({params:{slug:post.id},props:{target:postPath(post,posts)}}));}
return Astro.redirect(Astro.props.target,301);
